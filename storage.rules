rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Character portraits: users can upload/view/delete their own character portraits
    match /portraits/{characterImage} {
      // Allow read if authenticated
      allow read: if request.auth != null;
      
      // Allow write/delete only if user is authenticated
      allow write, delete: if request.auth != null;
    }
    
    // Equipment images: users can upload/view/delete their own character equipment images
    match /equipment/{characterId}/{equipmentImage} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null;
    }
    
    // Character sheets (PDFs): users can upload/view/delete their own character sheets
    match /character_sheets/{characterId}/{filename} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null;
    }
    
    // Campaign feed uploads: images/PDFs up to 5 MB. Membership is enforced
    // by the Firestore feed rules; files are only reachable via their post.
    match /campaign_files/{campaignId}/{uploaderId}/{filename} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       uploaderId == request.auth.uid &&
                       request.resource.size > 0 &&
                       request.resource.size <= 5 * 1024 * 1024 &&
                       request.resource.contentType in ['image/png', 'image/jpeg', 'application/pdf'];
      // The uploader stamps the campaign GM's uid into metadata so the GM can remove mistakes.
      allow delete: if request.auth != null &&
                       (uploaderId == request.auth.uid ||
                        resource.metadata.gmId == request.auth.uid);
    }    // Deny all other requests by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

// v2
